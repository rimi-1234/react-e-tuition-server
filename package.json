{
  "name": "edurock-api",
  "version": "2.0.0",
  "description": "Edurock tuition marketplace REST API (Express + MongoDB, MVC)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:fresh": "node src/scripts/seed.js --fresh",
    "lint": "node --check src/server.js",
    "test": "node --test --test-reporter=spec tests/",
    "seed:check": "node src/scripts/seed.js --dry-run"
  },
  "engines": {
    "node": ">=20.11"
  },
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase-admin": "^13.6.0",
    "helmet": "^8.1.0",
    "lru-cache": "^11.2.2",
    "mongoose": "^9.0.0",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "stripe": "^23.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4"
  }
}
