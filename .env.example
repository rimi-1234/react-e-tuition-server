# ── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ── MongoDB (use ONE of the two options) ────────────────────────────
# Option A: full connection string (recommended). Local: mongodb://127.0.0.1:27017
MONGODB_URI=
# Option B: legacy user/password for the Atlas cluster
MONGO_USER=
MONGO_PASS=
MONGO_CLUSTER=cluster0.dw7x2dn.mongodb.net
DB_NAME=edurock

# ── Firebase Admin (service account JSON, raw or base64) ────────────
# Encode a key file with: node src/scripts/encode-service-key.js ./key.json
FB_SERVICE_KEY=

# ── Stripe (test keys are fine) ─────────────────────────────────────
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/v1/payments/webhook`
# or the Stripe dashboard webhook endpoint. Optional: the client-side
# confirmation still works without it.
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY=bdt
PLATFORM_FEE_PERCENT=10

# ── CORS ────────────────────────────────────────────────────────────
# Production frontend origin (no trailing slash). Also used for Stripe redirects.
CLIENT_URL=http://localhost:5173
# Extra comma-separated origins (Vercel production/preview URLs)
CORS_ORIGINS=https://react-e-tuition-client.vercel.app,https://react-e-tution-session-client.vercel.app

# ── Caching & rate limits ───────────────────────────────────────────
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600

# Optional: custom DNS for Atlas SRV lookups (defaults to 8.8.8.8,1.1.1.1 in development)
DNS_SERVERS=
